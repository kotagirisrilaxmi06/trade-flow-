{
  "info": {
    "name": "TradeFlow ERP API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": { "raw": "http://localhost:4000/auth/login", "host": ["http://localhost:4000/auth/login"] }
      }
    },
    {
      "name": "List Customers",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:4000/customers", "host": ["http://localhost:4000/customers"] }
      }
    },
    {
      "name": "Create Customer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Customer\",\n  \"mobile\": \"9999999999\",\n  \"email\": \"customer@example.com\",\n  \"businessName\": \"New Customer Co\",\n  \"gstNumber\": \"27ABCDE1234F1Z5\",\n  \"customerType\": \"Wholesale\",\n  \"address\": \"Delhi\",\n  \"status\": \"Lead\",\n  \"followUpDate\": \"2026-07-24\",\n  \"notes\": \"Good lead\"\n}"
        },
        "url": { "raw": "http://localhost:4000/customers", "host": ["http://localhost:4000/customers"] }
      }
    },
    {
      "name": "Create Challan",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"c1\",\n  \"status\": \"Draft\",\n  \"createdBy\": \"admin@example.com\",\n  \"items\": [\n    {\n      \"productId\": \"p1\",\n      \"productName\": \"Steel Chair\",\n      \"sku\": \"ST-CHAIR-01\",\n      \"unitPrice\": 450,\n      \"quantity\": 2\n    }\n  ]\n}"
        },
        "url": { "raw": "http://localhost:4000/challans", "host": ["http://localhost:4000/challans"] }
      }
    }
  ]
}
