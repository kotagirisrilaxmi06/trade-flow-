{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/auth/(.*)", "dest": "/api/index.ts" },
    { "src": "/customers(.*)", "dest": "/api/index.ts" },
    { "src": "/products(.*)", "dest": "/api/index.ts" },
    { "src": "/challans(.*)", "dest": "/api/index.ts" },
    { "src": "/purchase-orders(.*)", "dest": "/api/index.ts" },
    { "src": "/invoices(.*)", "dest": "/api/index.ts" },
    { "src": "/health", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
